# Replaces Railpack's default Caddyfile: no SPA fallback, so unknown paths get a real 404
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	root * /app/dist

	encode {
		gzip
		zstd
	}

	try_files {path} {path}.html {path}/index.html

	file_server {
		hide .git
		hide .env*
	}

	handle_errors 404 {
		@en path /en /en/*
		rewrite @en /en/404.html
		rewrite * /404.html
		file_server
	}
}
